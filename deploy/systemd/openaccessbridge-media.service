# openaccessbridge-media — the supervised media process (buildplan §3.5).
# Runs the audio pipeline (capture → four-state qualifier → channel mapper → Opus
# → WebRTC) in isolation, so a media crash cannot drop the caption lease or the
# admin surface. Unprivileged; talks to core over a loopback Unix socket.
[Unit]
Description=OpenAccessBridge media (audio capture/qualify/encode/WebRTC)
PartOf=openaccessbridge.target
After=openaccessbridge-firewall.service

[Service]
Type=simple
User=openaccessbridge
Group=openaccessbridge
# audio group for ALSA device access on the real appliance.
SupplementaryGroups=audio
ExecStart=/usr/local/bin/openaccessbridge-media --socket-dir=/run/openaccessbridge
Restart=on-failure
RestartSec=2

# 0770 + preserve: the three processes share this tmpfs runtime dir for their
# loopback sockets, so it must outlive any single unit's stop (§3.5); group-
# writable so the root helper can create its socket beside this one whichever
# unit owns the directory (see openaccessbridge-core.service).
RuntimeDirectory=openaccessbridge
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes

# No persistence of audio (guardrail #5): audio is transient; no writable disk.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
# Core dumps disabled — a crash dump could carry audio samples (§9.4).
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no

[Install]
WantedBy=openaccessbridge.target
