# openaccessbridge-core — the main supervised process (buildplan §3.5): ACSP state
# machine, RPL/timed-text parsing, timing engine, caption fan-out, web/admin
# server. It connects to the media and firewall helpers over loopback and reports
# their liveness to the dashboard.
#
# Wants (not Requires) the media helper, so a media crash does NOT stop captions
# or the admin surface — captions and audio are independent (§2, §3.5).
[Unit]
Description=OpenAccessBridge core (captions, web/admin, supervision)
PartOf=openaccessbridge.target
After=openaccessbridge-firewall.service openaccessbridge-media.service
Wants=openaccessbridge-media.service
Requires=openaccessbridge-firewall.service

[Service]
Type=simple
User=openaccessbridge
Group=openaccessbridge
ExecStart=/usr/local/bin/openaccessbridge-core \
    --config=/var/lib/openaccessbridge/config.db \
    --patron-bind=0.0.0.0:80 \
    --admin-bind=127.0.0.1:8443
Restart=on-failure
RestartSec=2

# 0750 + preserve: the three processes share this tmpfs runtime dir for their
# loopback sockets, so it must outlive any single unit's stop (§3.5).
RuntimeDirectory=openaccessbridge
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# Only the SQLite CONFIG store is writable (configuration only — never content).
StateDirectory=openaccessbridge
StateDirectoryMode=0700
ReadWritePaths=/var/lib/openaccessbridge

# Bind to privileged port 80 without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
# Core dumps disabled — a crash dump could carry caption text (§9.4).
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=openaccessbridge.target
