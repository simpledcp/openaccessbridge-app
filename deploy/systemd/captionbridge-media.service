# captionbridge-media — the supervised media process (buildplan §3.5).
# Runs the audio pipeline (capture → four-state qualifier → channel mapper → Opus
# → WebRTC) in isolation, so a media crash cannot drop the caption lease or the
# admin surface. Unprivileged; talks to core over a loopback Unix socket.
[Unit]
Description=CaptionBridge media (audio capture/qualify/encode/WebRTC)
PartOf=captionbridge.target
After=captionbridge-firewall.service

[Service]
Type=simple
User=captionbridge
Group=captionbridge
# audio group for ALSA device access on the real appliance.
SupplementaryGroups=audio
ExecStart=/usr/local/bin/captionbridge-media --socket-dir=/run/captionbridge
Restart=on-failure
RestartSec=2

# 0750 + preserve: the three processes share this tmpfs runtime dir for their
# loopback sockets, so it must outlive any single unit's stop (§3.5).
RuntimeDirectory=captionbridge
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# No persistence of audio (guardrail #5): audio is transient; no writable disk.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
# Core dumps disabled — a crash dump could carry audio samples (§9.4).
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no

[Install]
WantedBy=captionbridge.target
