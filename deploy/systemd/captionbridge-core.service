# captionbridge-core — the main supervised process (buildplan §3.5): ACSP state
# machine, RPL/timed-text parsing, timing engine, caption fan-out, web/admin
# server. It connects to the media and firewall helpers over loopback and reports
# their liveness to the dashboard.
#
# Wants (not Requires) the media helper, so a media crash does NOT stop captions
# or the admin surface — captions and audio are independent (§2, §3.5).
[Unit]
Description=CaptionBridge core (captions, web/admin, supervision)
PartOf=captionbridge.target
After=captionbridge-firewall.service captionbridge-media.service
Wants=captionbridge-media.service
Requires=captionbridge-firewall.service

[Service]
Type=simple
User=captionbridge
Group=captionbridge
ExecStart=/usr/local/bin/captionbridge-core \
    --config=/var/lib/captionbridge/config.db \
    --patron-bind=0.0.0.0:80 \
    --admin-bind=127.0.0.1:8443
Restart=on-failure
RestartSec=2

RuntimeDirectory=captionbridge
RuntimeDirectoryMode=0700
# Only the SQLite CONFIG store is writable (configuration only — never content).
StateDirectory=captionbridge
StateDirectoryMode=0700
ReadWritePaths=/var/lib/captionbridge

# Bind to privileged port 80 without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
# Core dumps disabled — a crash dump could carry caption text (§9.4).
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=captionbridge.target
