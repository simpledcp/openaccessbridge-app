# openaccessbridge-firewall — the privileged network helper (buildplan §3.5).
# The ONLY component that runs as root: it applies the nftables ruleset and
# verifies forwarding/isolation. Kept small and auditable, separate from the large
# web/parsing surface. Talks to core over a loopback Unix socket only.
[Unit]
Description=OpenAccessBridge privileged firewall/verification helper
Documentation=https://example.invalid/openaccessbridge
Before=openaccessbridge-core.service
PartOf=openaccessbridge.target

[Service]
Type=simple
# Needs root for nftables + sysctl forwarding control; restrict capabilities to
# exactly what network state management requires.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
# Runs as root (uid 0) but with the SHARED GROUP, so the loopback socket it
# creates is root:openaccessbridge 0660 and the unprivileged core can reach it.
# Without this the only channel to the privileged helper is unreachable and the
# dashboard reports a permanent "Firewall INACTIVE" (§3.5).
Group=openaccessbridge
ExecStart=/usr/local/bin/openaccessbridge-firewall --socket-dir=/run/openaccessbridge
Restart=on-failure
RestartSec=2

# Runtime dir is tmpfs (sockets/transient state only — never content; §9.4).
# 0770 so the shared group can create its sockets beside this one whichever
# unit owns the directory at the time (see openaccessbridge-core.service);
# preserved so stopping any one unit does not delete the directory the other
# two are still using.
RuntimeDirectory=openaccessbridge
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes

# Hardening.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=no
# Core dumps disabled in production — the classic way content leaks to disk (§9.4).
LimitCORE=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=openaccessbridge.target
